# RUN: yaml2obj %s -o %t
# RUN: llvm-readobj --file-headers %t | FileCheck %s

# CHECK:      Format: elf32-mera400
# CHECK-NEXT: Arch: mera400
# CHECK-NEXT: AddressSize: 32bit
# CHECK:      Class: 32-bit
# CHECK:      DataEncoding: BigEndian
# CHECK:      Machine: EM_MERA400_EXPERIMENTAL (0x4D34)

--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2MSB
  Type:    ET_REL
  Machine: EM_MERA400_EXPERIMENTAL
