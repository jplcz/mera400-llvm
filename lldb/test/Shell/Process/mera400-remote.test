# REQUIRES: mera400
# LLDB talks to a fake MERA-400 debug stub: it learns the register layout from
# the stub's target description and can read registers and memory.
# RUN: %python %S/Inputs/mera400-stub.py %S/Inputs/mera400-core.xml \
# RUN:   %lldb -b -o "gdb-remote 127.0.0.1:@PORT@" -o "register read r1 r2 r7 ic" \
# RUN:   -o "memory read -s1 -c8 -fx 0x100" -o "thread backtrace" -o "detach" 2>&1 | FileCheck %s
# CHECK: Process {{.*}} stopped
# CHECK: r1 = 0x1234
# CHECK: r2 = 0x5678
# CHECK: r7 = 0x0100
# CHECK: ic = 0x00000200
# CHECK: 0x00000100: 0xde 0xad 0xbe 0xef 0x01 0x02 0x03 0x04
# CHECK: frame #0: 0x00000200
